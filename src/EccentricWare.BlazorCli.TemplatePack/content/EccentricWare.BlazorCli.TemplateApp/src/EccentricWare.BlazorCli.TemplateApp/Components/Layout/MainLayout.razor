@inherits LayoutComponentBase
@inject IApplicationStatusService StatusService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="ToggleDrawer" Color="Color.Inherit" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="app-title" title="@_applicationName" data-testid="app-title">@_applicationName</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="app-caption" data-testid="loopback-caption">Loopback only</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Start" Variant="DrawerVariant.Responsive" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="dashboard-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private string _applicationName = "";

    protected override void OnInitialized() => _applicationName = StatusService.GetStatus(AppMode.Web).Application;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
